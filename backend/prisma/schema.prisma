generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model categories {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String    @unique @db.VarChar(50)
  description String?
  is_active   Boolean   @default(true)
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  updated_at  DateTime  @default(now()) @db.Timestamptz(6)
  tickets     tickets[]

  @@index([is_active], map: "idx_categories_is_active")
}

model departments {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String    @unique @db.VarChar(100)
  description String?
  is_active   Boolean   @default(true)
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  updated_at  DateTime  @default(now()) @db.Timestamptz(6)
  tickets     tickets[]
  users       users[]

  @@index([is_active], map: "idx_departments_is_active")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model ticket_assignments {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticket_id        String    @db.Uuid
  technician_id    String    @db.Uuid
  assigned_by      String    @db.Uuid
  assigned_at      DateTime  @default(now()) @db.Timestamptz(6)
  unassigned_at    DateTime? @db.Timestamptz(6)
  is_current       Boolean   @default(true)
  notes            String?
  assigned_by_user users     @relation("dispatched_assignments", fields: [assigned_by], references: [id], map: "fk_assignments_assigned_by")
  technician       users     @relation("technician_assignments", fields: [technician_id], references: [id], map: "fk_assignments_technician")
  ticket           tickets   @relation(fields: [ticket_id], references: [id], onDelete: Cascade, map: "fk_assignments_ticket")

  @@index([technician_id, is_current], map: "idx_assignments_technician")
  @@index([ticket_id], map: "idx_assignments_ticket_id")
}

model ticket_comments {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticket_id   String   @db.Uuid
  author_id   String   @db.Uuid
  content     String
  is_internal Boolean  @default(false)
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @default(now()) @db.Timestamptz(6)
  author      users    @relation(fields: [author_id], references: [id], map: "fk_comments_author")
  ticket      tickets  @relation(fields: [ticket_id], references: [id], onDelete: Cascade, map: "fk_comments_ticket")

  @@index([author_id], map: "idx_comments_author_id")
  @@index([ticket_id, is_internal], map: "idx_comments_ticket_internal")
}

model ticket_status_history {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticket_id       String         @db.Uuid
  changed_by      String         @db.Uuid
  previous_status ticket_status?
  new_status      ticket_status
  changed_at      DateTime       @default(now()) @db.Timestamptz(6)
  reason          String?
  actor           users          @relation(fields: [changed_by], references: [id], map: "fk_status_history_changed_by")
  ticket          tickets        @relation(fields: [ticket_id], references: [id], onDelete: Cascade, map: "fk_status_history_ticket")

  @@index([changed_by], map: "idx_status_history_changed_by")
  @@index([ticket_id, changed_at], map: "idx_status_history_ticket")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model tickets {
  id                    String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticket_number         String                  @unique @default(dbgenerated("('TKT-'::text || lpad((nextval('ticket_number_seq'::regclass))::text, 6, '0'::text))")) @db.VarChar(20)
  title                 String                  @db.VarChar(150)
  description           String
  category_id           String                  @db.Uuid
  priority              ticket_priority         @default(MEDIUM)
  status                ticket_status           @default(OPEN)
  employee_id           String                  @db.Uuid
  department_id         String                  @db.Uuid
  resolution            String?
  resolved_by           String?                 @db.Uuid
  closed_by             String?                 @db.Uuid
  created_at            DateTime                @default(now()) @db.Timestamptz(6)
  updated_at            DateTime                @default(now()) @db.Timestamptz(6)
  resolved_at           DateTime?               @db.Timestamptz(6)
  closed_at             DateTime?               @db.Timestamptz(6)
  ticket_assignments    ticket_assignments[]
  ticket_comments       ticket_comments[]
  ticket_status_history ticket_status_history[]
  category              categories              @relation(fields: [category_id], references: [id], map: "fk_tickets_category")
  closed_by_user        users?                  @relation("closed_tickets", fields: [closed_by], references: [id], onDelete: Restrict, map: "fk_tickets_closed_by")
  department            departments             @relation(fields: [department_id], references: [id], map: "fk_tickets_department")
  employee              users                   @relation("submitted_tickets", fields: [employee_id], references: [id], map: "fk_tickets_employee")
  resolved_by_user      users?                  @relation("resolved_tickets", fields: [resolved_by], references: [id], onDelete: Restrict, map: "fk_tickets_resolved_by")

  @@index([category_id], map: "idx_tickets_category_id")
  @@index([created_at(sort: Desc)], map: "idx_tickets_created_at")
  @@index([department_id], map: "idx_tickets_department_id")
  @@index([employee_id], map: "idx_tickets_employee_id")
  @@index([priority], map: "idx_tickets_priority")
  @@index([status], map: "idx_tickets_status")
  @@index([ticket_number], map: "idx_tickets_ticket_number")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model users {
  id                     String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  first_name             String                  @db.VarChar(50)
  last_name              String                  @db.VarChar(50)
  email                  String                  @unique @db.VarChar(255)
  password_hash          String                  @db.VarChar(255)
  role                   user_role               @default(EMPLOYEE)
  department_id          String                  @db.Uuid
  employee_id            String?                 @unique @db.VarChar(50)
  phone_number           String?                 @db.VarChar(30)
  is_active              Boolean                 @default(true)
  created_at             DateTime                @default(now()) @db.Timestamptz(6)
  updated_at             DateTime                @default(now()) @db.Timestamptz(6)
  dispatched_assignments ticket_assignments[]    @relation("dispatched_assignments")
  technician_assignments ticket_assignments[]    @relation("technician_assignments")
  ticket_comments        ticket_comments[]
  ticket_status_history  ticket_status_history[]
  closed_tickets         tickets[]               @relation("closed_tickets")
  submitted_tickets      tickets[]               @relation("submitted_tickets")
  resolved_tickets       tickets[]               @relation("resolved_tickets")
  department             departments             @relation(fields: [department_id], references: [id], map: "fk_users_department")

  @@index([department_id], map: "idx_users_department_id")
  @@index([email], map: "idx_users_email")
  @@index([employee_id], map: "idx_users_employee_id")
  @@index([is_active], map: "idx_users_is_active")
  @@index([role], map: "idx_users_role")
}

enum ticket_priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ticket_status {
  OPEN
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  CLOSED
  CANCELLED
}

enum user_role {
  EMPLOYEE
  TECHNICIAN
  ADMINISTRATOR
}
